# Application
APP_ENV=development
APP_PUBLIC_URL=http://localhost:5173

# Storage mode is intentionally server-side only.
STORAGE_MODE=server

# Current Sites/D1 runtime
# In the hosted Sites environment the DB binding is provided by the platform.
D1_BINDING_NAME=DB

# Target self-hosted database
# Fill this only after the PostgreSQL adapter is implemented.
DATABASE_PROVIDER=postgres
DATABASE_URL=postgres://program_constructor:change_me@localhost:5432/program_constructor

# Target corporate OIDC / SSO
# Fill these values in the server secret store, not in GitHub.
OIDC_ISSUER_URL=https://sso.example.edu/realms/example
OIDC_CLIENT_ID=program-constructor
OIDC_CLIENT_SECRET=change_me
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# Initial administrator bootstrap
# Use only for first deployment/bootstrap scripts; do not use as a permanent auth bypass.
INITIAL_ADMIN_EMAIL=admin@example.edu
